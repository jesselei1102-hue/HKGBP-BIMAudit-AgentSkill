# Only the Model Audit package and its design documents are published from this folder.
# Tests, validation scripts, fixtures and the dev harness stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CHANGELOG.md
!/model-audit/
!/model-audit-design/
/model-audit-design/_agent/
/model-audit/app/test/
/model-audit/app/dev/
/model-audit/app/vitest.config.ts
__pycache__/
*.pyc

# Impeccable working files (local only)
/model-audit/.impeccable/review/
/model-audit/.impeccable/questions/
/model-audit/.impeccable/hook.cache.json
